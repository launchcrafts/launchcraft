# Copy the values you need into .env.local (local dev) and into
# AWS Amplify → App settings → Environment variables (production).

# Contact form + Logo Maker lead emails
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── AI Logo Maker (/logo-maker) ─────────────────────────────
# Cloudflare dashboard → right sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare dashboard → My Profile → API Tokens → Create Token → "Workers AI" template
CLOUDFLARE_API_TOKEN=

# Optional: free captcha (Cloudflare dashboard → Turnstile → Add widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional tuning
# LOGO_DAILY_LIMIT_PER_IP=4        # generations per visitor per day (each = 4 logos)
# LOGO_DAILY_LIMIT_GLOBAL=40       # total generations per day (~9,200 of the 10,000 free neurons)
# LOGO_STEPS=4                     # FLUX quality steps, 1–8 (more = slower, uses more quota)
# CLOUDFLARE_AI_BASE_URL=          # optional AI Gateway URL, e.g. https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/workers-ai
# LEAD_EMAIL_TO=launchcrafts.in@gmail.com
